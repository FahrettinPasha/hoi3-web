{
  "name": "hoi3-web",
  "version": "0.1.0",
  "private": true,
  "description": "Operation Europa - Web-based Grand Strategy Game",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspace=packages/frontend",
    "test": "npm run test --workspace=packages/frontend",
    "lint": "npm run lint --workspace=packages/frontend",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
